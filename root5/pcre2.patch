diff -Naur root5_old/core/pcre/Module.mk root5_new/core/pcre/Module.mk
--- root5_old/core/pcre/Module.mk	2025-09-10 14:42:06.000000000 +0200
+++ root5_new/core/pcre/Module.mk	2026-09-29 23:47:28.549588626 +0200
@@ -8,8 +8,9 @@
 
 ifneq ($(BUILTINPCRE), yes)
 
-PCRELIBF     := $(shell pcre-config --libs)
-PCREINC      := $(shell pcre-config --cflags)
+# in 'core/base/src/TPRegexp.cxx' #define PCRE2_CODE_UNIT_WIDTH 8
+PCRELIBF     := $(shell pcre2-config --libs8)
+PCREINC      := $(shell pcre2-config --cflags)
 PCRELIB      := $(filter -l%,$(PCRELIBF))
 PCRELDFLAGS  := $(filter-out -l%,$(PCRELIBF))
 PCREDEP      :=
